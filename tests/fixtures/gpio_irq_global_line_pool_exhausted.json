{
  "mcu": "MIK32",
  "version": "2.0",
  "peripherals": [
    {
      "type": "gpio",
      "instance": 0,
      "mode": "input",
      "pull": "none",
      "drive_strength": "2mA",
      "pins": [3],
      "interrupts": [
        { "pin": 3, "line": 3, "trigger": "rising" }
      ]
    },
    {
      "type": "gpio",
      "instance": 1,
      "mode": "input",
      "pull": "none",
      "drive_strength": "2mA",
      "pins": [3],
      "interrupts": [
        { "pin": 3, "line": 3, "trigger": "falling" }
      ]
    }
  ]
}
