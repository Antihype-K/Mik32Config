{
  "mcu": "MIK32",
  "version": "2.0",
  "peripherals": [
    {
      "type": "gpio",
      "instance": 0,
      "mode": "input",
      "pull": "none",
      "drive_strength": "2mA",
      "pins": [0, 4],
      "interrupts": [
        { "pin": 0, "line": 0, "trigger": "rising" },
        { "pin": 4, "line": 0, "trigger": "falling" }
      ]
    }
  ]
}
