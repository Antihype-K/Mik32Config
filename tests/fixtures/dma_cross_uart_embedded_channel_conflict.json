{
  "mcu": "MIK32",
  "version": "2.0",
  "peripherals": [
    {
      "type": "uart",
      "instance": 0,
      "baud_rate": 9600,
      "data_bits": 8,
      "stop_bits": 1,
      "parity": "none",
      "flow_control": false,
      "direction": "duplex",
      "dma": [
        { "channel": 0, "direction": "tx", "buffer_type": "linear", "buffer_size_bytes": 32, "element_size": "byte", "increment": true }
      ]
    },
    { "type": "dma", "instance": 0, "request": "spi_0", "direction": "peripheral_to_memory", "buffer_size_bytes": 16, "element_size": "byte" }
  ]
}
