{
  "mcu": "MIK32",
  "version": "2.0",
  "peripherals": [
    {
      "type": "uart",
      "instance": 0,
      "baud_rate": 115200,
      "data_bits": 8,
      "stop_bits": 1,
      "parity": "none",
      "flow_control": true,
      "direction": "duplex",
      "bit_direction": "msb_first",
      "channel_mode": "half_duplex",
      "tx_inversion": true,
      "rx_inversion": true,
      "swap": true,
      "rts_mode": "modem",
      "modem_signals": {
        "ri": true,
        "dsr": true,
        "dtr": true,
        "ddis": true,
        "dcd": true
      }
    }
  ]
}
