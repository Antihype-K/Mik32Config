{
  "mcu": "MIK32",
  "version": "2.0",
  "clock": {
    "oscillator_system": "hsi32m",
    "oscillator_enable": ["hsi32m"],
    "force_osc_sys": true,
    "hsi32m_calibration": 128
  },
  "peripherals": [
    {
      "type": "uart",
      "instance": 0,
      "baud_rate": 38400,
      "data_bits": 8,
      "stop_bits": 1,
      "parity": "none",
      "flow_control": false,
      "direction": "duplex"
    }
  ]
}
