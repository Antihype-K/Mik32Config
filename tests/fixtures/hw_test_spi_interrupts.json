{
  "mcu": "MIK32",
  "version": "2.0",
  "peripherals": [
    {
      "type": "uart",
      "instance": 0,
      "baud_rate": 38400,
      "data_bits": 8,
      "stop_bits": 1,
      "parity": "none",
      "flow_control": false,
      "direction": "duplex"
    },
    {
      "type": "spi",
      "instance": 0,
      "mode": "master",
      "clk_phase": "on",
      "clk_polarity": "high",
      "threshold_tx": 4,
      "baud_rate_div": 64,
      "manual_cs": true,
      "decoder": false,
      "chip_select": "cs0",
      "interrupts": ["rx_fifo_not_empty", "tx_fifo_not_full", "rx_overflow", "mode_fail"]
    }
  ]
}
